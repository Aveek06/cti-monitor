  "relationships": [
    { "id": "ioc_actor", "from": "ioc_indicators", "to": "threat_actor_profiles", "label": "attributed_apt = actor_name", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one", "toOptional": true, "identifying": false },
    { "id": "ttp_actor", "from": "ttp_observations", "to": "threat_actor_profiles", "label": "attributed_apt = actor_name", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one", "toOptional": true, "identifying": false },
    { "id": "sigma_ttp", "from": "sigma_rules", "to": "ttp_observations", "label": "technique_id + source_article", "fromCardinality": "one", "fromOptional": true, "toCardinality": "one", "identifying": false }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Logical links, not foreign keys",
      "items": [
        "The database declares no foreign keys; tables join on shared text values",
        "IOCs and TTPs share a source_article, which is how Sigma drafting finds an article's indicators",
        "attributed_apt on IOCs and TTPs matches actor_name on the actor profile"
      ]
    },
    {
      "dot": "amber",
      "title": "Uniqueness",
      "items": [
        "ioc_indicators is unique on (value, type); stix_id is a deterministic UUID, so re-ingesting never duplicates",
        "ttp_observations and sigma_rules are each unique on (technique_id, source_article): first draft wins",
        "site_ratings joins to sources by site name; sources themselves live in config.json"
      ]
    }
  ]
}
